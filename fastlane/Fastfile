fastlane_version "2.0.0"

PUBSPEC_PATH = File.expand_path("../pubspec.yaml", __dir__)
IOS_DIR = File.expand_path("../ios", __dir__)
ANDROID_DIR = File.expand_path("../android", __dir__)

desc "현재 pubspec.yaml 버전 확인 (iOS/Android 공유 소스)"
lane :show_version do
  content = File.read(PUBSPEC_PATH)
  if content =~ /^version:\s*(\S+)\+(\d+)/
    UI.important("현재 버전: #{$1}+#{$2}")
  else
    UI.user_error!("pubspec.yaml에서 version을 찾을 수 없음")
  end
end

desc "빌드 번호 +1 (pubspec.yaml) - iOS/Android 모두 반영"
lane :bump_build do
  content = File.read(PUBSPEC_PATH)
  if content =~ /^version:\s*(\S+)\+(\d+)/
    version = $1
    new_build = $2.to_i + 1
    new_content = content.sub(/^version:\s*\S+\+\d+/, "version: #{version}+#{new_build}")
    File.write(PUBSPEC_PATH, new_content)
    UI.success("빌드 번호 업데이트: #{version}+#{new_build} (iOS/Android 공통)")
  else
    UI.user_error!("pubspec.yaml에서 version을 찾을 수 없음")
  end
end

desc "마케팅 버전 설정 (예: fastlane bump_version version:1.2.0)"
lane :bump_version do |options|
  new_version = options[:version]
  UI.user_error!("version 파라미터 필요 (예: fastlane bump_version version:1.2.0)") unless new_version
  content = File.read(PUBSPEC_PATH)
  if content =~ /^version:\s*(\S+)\+(\d+)/
    build = $2
    new_content = content.sub(/^version:\s*\S+\+\d+/, "version: #{new_version}+#{build}")
    File.write(PUBSPEC_PATH, new_content)
    UI.success("마케팅 버전 업데이트: #{new_version}+#{build}")
  else
    UI.user_error!("pubspec.yaml에서 version을 찾을 수 없음")
  end
end

desc "iOS TestFlight + Android 내부 테스트 동시 배포 (빌드번호 자동 +1)"
lane :release_internal do
  bump_build

  UI.header("iOS TestFlight 배포 시작")
  Dir.chdir(IOS_DIR) { sh("bundle exec fastlane ios beta") }

  UI.header("Android 내부 테스트 배포 시작")
  Dir.chdir(ANDROID_DIR) { sh("bundle exec fastlane android internal") }

  UI.success("양쪽 플랫폼 내부 테스트 배포 완료")
end

desc "iOS App Store 심사 + Android 프로덕션(심사) 배포 (빌드번호 자동 +1)"
lane :release_production do
  bump_build

  UI.header("iOS App Store 심사 제출 시작")
  Dir.chdir(IOS_DIR) { sh("bundle exec fastlane ios production") }

  UI.header("Android 프로덕션 배포 시작")
  Dir.chdir(ANDROID_DIR) { sh("bundle exec fastlane android production") }

  UI.success("양쪽 플랫폼 심사 제출 완료 (각 스토어에서 승인 후 수동 출시 필요)")
end
