# Google/Flutter 공식 권고를 기준으로 한 화면 성능 품질 게이트.
# 출처와 이 프로젝트에서의 적용 방식은 docs/품질게이트.md에 기록한다.

# 60 Hz 화면의 한 프레임 예산. Flutter 공식 권고: 총 16 ms 이하.
QUALITY_FRAME_BUDGET_MS=16.67

# 반복 측정 프레임 중 예산을 넘겨도 허용할 최대 비율.
# 공식 수치가 아닌 이 프로젝트의 엄격한 회귀 방지 기준이다.
QUALITY_MAX_SLOW_FRAME_PERCENT=1.0

# 자동 AVD의 호스트 스케줄링 흔들림을 허용하는 회귀 기준.
# 실기기 제품 기준 1%와 별도로 적용한다.
QUALITY_EMULATOR_MAX_SLOW_FRAME_PERCENT=3.0

# Android가 frozen frame으로 정의하는 경계. 한 건도 허용하지 않는다.
QUALITY_FROZEN_FRAME_MS=700
QUALITY_MAX_FROZEN_FRAMES=0

# Google 권고 콜드 스타트 목표. ADB TotalTime 5회 측정의 중앙값에 적용한다.
QUALITY_COLD_START_P50_MS=500

# 기기 편차를 감안한 프로젝트 보조 기준. 공식 기준이 아니라 회귀 감시용이다.
QUALITY_COLD_START_P95_MS=1000

# 자동 AVD는 호스트 부하와 가상화 비용을 포함하므로 실기기 목표와 분리한다.
# 기능·회귀 감시용 한도이며 제품 성능 합격 기준으로 사용하지 않는다.
QUALITY_EMULATOR_COLD_START_P50_MS=4000
QUALITY_EMULATOR_COLD_START_P95_MS=6000

# 실제 기기에서 반복할 콜드 스타트 횟수.
QUALITY_STARTUP_SAMPLES=5

# API 부하 검사 기본 기준.
QUALITY_API_P95_MS=500
QUALITY_API_ERROR_RATE_PERCENT=1.0

# 로그아웃 소유권·인증 보존·민원 답변 회귀는 실패 0건이 기준이다.
# 이 보안/기능 검사는 성능 허용치로 완화하지 않는다.
