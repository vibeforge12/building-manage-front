default_platform(:ios)

# App Store Connect API Key 정보 (실제 값으로 교체)
API_KEY_PATH = File.expand_path("../../../private_keys/AuthKey_YOUR_KEY_ID.p8", __dir__)
API_KEY_ID = "YOUR_KEY_ID"
API_ISSUER_ID = "YOUR_ISSUER_ID"

IPA_PATH = File.expand_path("../../build/ios/ipa/엄지.ipa", __dir__)

platform :ios do
  desc "Flutter iOS 릴리즈 빌드 (.ipa 생성)"
  lane :build do
    sh("cd ../.. && fvm flutter clean")
    sh("cd ../.. && fvm flutter pub get")
    sh("cd ../.. && fvm flutter build ipa --release")
    UI.success("IPA 빌드 완료: #{IPA_PATH}")
  end

  desc "기존 IPA를 TestFlight에 업로드 (빌드 안 함)"
  lane :upload do
    unless File.exist?(IPA_PATH)
      UI.user_error!("IPA 파일 없음: #{IPA_PATH}\n먼저 `fastlane ios build` 실행")
    end

    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true,
      changelog: "새 빌드 업로드",
    )
  end

  desc "빌드 + TestFlight 업로드"
  lane :beta do
    build
    upload
  end

  desc "TestFlight 최신 빌드를 App Store 심사에 제출 (업로드 안 함)"
  lane :submit_review do
    UI.important("⚠️  App Store 프로덕션 심사 제출 시도")
    unless UI.confirm("정말 App Store 심사에 제출하시겠습니까?")
      UI.user_error!("배포 취소됨")
    end

    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    # TestFlight에 올라간 빌드를 App Store 버전에 첨부해 심사 제출.
    # 승인 후 자동 공개 안 함 → App Store Connect에서 수동 "출시" 클릭 필요
    # (Android "관리되는 게시"와 일관된 패턴)
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      }
    )
  end

  desc "빌드 + TestFlight + App Store 심사 제출 (스토어 공개 배포)"
  lane :production do
    build
    upload
    submit_review
  end

end

