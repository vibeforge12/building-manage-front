default_platform(:ios)

# App Store Connect API Key 정보 (실제 값으로 교체)
API_KEY_PATH = File.expand_path("../../../private_keys/AuthKey_YOUR_KEY_ID.p8", __dir__)
API_KEY_ID = "YOUR_KEY_ID"
API_ISSUER_ID = "YOUR_ISSUER_ID"

IPA_PATH = File.expand_path("../../build/ios/ipa/엄지.ipa", __dir__)

platform :ios do
  desc "Flutter iOS 릴리즈 빌드 (.ipa 생성)"
  lane :build do
    sh("cd ../.. && fvm flutter clean")
    sh("cd ../.. && fvm flutter pub get")
    sh("cd ../.. && fvm flutter build ipa --release")
    UI.success("IPA 빌드 완료: #{IPA_PATH}")
  end

  desc "기존 IPA를 TestFlight에 업로드 (빌드 안 함)"
  lane :upload do
    unless File.exist?(IPA_PATH)
      UI.user_error!("IPA 파일 없음: #{IPA_PATH}\n먼저 `fastlane ios build` 실행")
    end

    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true,
      changelog: "새 빌드 업로드",
    )
  end

  desc "빌드 + TestFlight 업로드"
  lane :beta do
    build
    upload
  end

  desc "빌드 번호 +1 (pubspec.yaml)"
  lane :bump_build do
    pubspec_path = File.expand_path("../../pubspec.yaml", __dir__)
    content = File.read(pubspec_path)
    if content =~ /^version:\s*(\S+)\+(\d+)/
      version = $1
      build = $2.to_i + 1
      new_content = content.sub(/^version:\s*\S+\+\d+/, "version: #{version}+#{build}")
      File.write(pubspec_path, new_content)
      UI.success("버전 업데이트: #{version}+#{build}")
    else
      UI.error("pubspec.yaml에서 version 찾을 수 없음")
    end
  end
end
